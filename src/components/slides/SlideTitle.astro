---
interface Props {
  title: string;
  subtitle?: string;
  meta?: string;
}
const { title, subtitle, meta } = Astro.props;
---
<div class="slide-title-layout">
  {meta && <div class="slide-meta">{meta}</div>}
  {/* ページの h1 はデッキタイトル（スライドページ側で付与）なので、表紙の見出しは h2 にする */}
  <h2 class="slide-title-heading">{title}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .slide-title-layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .slide-meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 2px 8px;
    align-self: flex-start;
  }

  /* 従来 Slide の共通 h1 スタイルで描画されていた見た目を維持する */
  .slide-title-layout .slide-title-heading {
    font-size: 5.5cqi;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 0.3em;
  }

  .subtitle {
    font-size: clamp(0.85rem, 1.6vw, 1.2rem);
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 400;
  }
</style>
