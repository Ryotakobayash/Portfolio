---
import { Image } from 'astro:assets';
import { getSlideImageWidths, resolveSlideImage } from './resolveSlideImage';

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  caption?: string;
  fit?: 'contain' | 'cover';
  bare?: boolean;
  /** 画像の表示寸法がスライドの枠で決まる場合に指定 */
  responsive?: boolean;
}
const { src: rawSrc, alt = '', caption, fit = 'contain', bare = false, responsive = false } = Astro.props;
const src = resolveSlideImage(rawSrc);
---
<figure class="image-slide" data-fit={fit} data-bare={bare}>
  {typeof src === 'string' ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={responsive || fit === 'cover' ? getSlideImageWidths(src) : undefined}
      sizes={responsive || fit === 'cover' ? '100vw' : undefined}
      loading="lazy"
      decoding="async"
    />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .image-slide {
    margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5cqi;
    min-height: 0;
  }

  .image-slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--color-border);
    margin: 0;
  }

  .image-slide[data-fit="cover"] img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* <Slide bleed> の中ではスライド全面に敷く */
  :global(.slide[data-bleed="true"]) .image-slide {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  :global(.slide[data-bleed="true"]) .image-slide img {
    width: 100%;
    height: 100%;
  }

  .image-slide[data-bare="true"] img {
    border: none;
  }

  .image-slide figcaption {
    font-family: var(--font-mono);
    font-size: 1.4cqi;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
