---
/**
 * CRTOverlay — subtle CRT scanline effect
 *
 * A fixed full-screen overlay that adds subtle horizontal scanlines.
 * pointer-events: none ensures it never blocks user interaction.
 */
---

<div aria-hidden="true" class="crt-scanlines"></div>

<style>
  .crt-scanlines {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9000;
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, var(--crt-scanline-opacity, 0.04)) 2px,
      rgba(0, 0, 0, var(--crt-scanline-opacity, 0.04)) 3px
    );
    mix-blend-mode: multiply;
  }
</style>
