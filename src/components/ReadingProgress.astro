---
/**
 * 読了プログレスバー コンポーネント
 * 
 * 1960年代の計器盤・パンチカードの世界観に合わせ、スクロール量に応じてドットが点灯する演出。
 * モダンCSSの Scroll-driven Animations (animation-timeline: scroll()) を使用し、
 * JavaScript ゼロ行・Compositor Thread 駆動で超軽量に動作します。
 * 非対応環境向けには機能判定付きの軽量スクロールイベントフォールバックを提供。
 */
---

<div class="reading-progress-track" aria-hidden="true">
  <div class="reading-progress-fill" id="reading-progress-fill"></div>
</div>

<script>
  // 非対応ブラウザ (Firefox等) 向けの軽量フォールバック
  function setupReadingProgressFallback() {
    if (typeof CSS !== 'undefined' && CSS.supports && CSS.supports('animation-timeline', 'scroll()')) {
      return; // ネイティブ対応環境は CSS に任せる
    }

    const fill = document.getElementById('reading-progress-fill');
    if (!fill) return;

    let ticking = false;
    const updateProgress = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const scrolled = window.scrollY;
      const ratio = Math.min(1, Math.max(0, scrolled / scrollable));
      fill.style.transform = `scaleX(${ratio})`;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }, { passive: true });

    updateProgress();
  }

  document.addEventListener('astro:page-load', setupReadingProgressFallback);
</script>

<style>
  .reading-progress-track {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100%;
    height: 4px;
    z-index: 99;
    pointer-events: none;
    /* 背景トラック: 等間隔の薄いパンチカード穴 */
    background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
    background-size: 8px 4px;
    background-repeat: repeat-x;
    background-position: left center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  :global([data-theme="dark"]) .reading-progress-track {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .reading-progress-fill {
    width: 100%;
    height: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    /* 読了部分: プライマリカラーで点灯するドット列 */
    background-image: radial-gradient(circle, var(--color-primary) 1.5px, transparent 1.5px);
    background-size: 8px 4px;
    background-repeat: repeat-x;
    background-position: left center;
  }

  /* Scroll-driven Animations ネイティブ対応環境 */
  @supports (animation-timeline: scroll()) {
    @keyframes grow-reading-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .reading-progress-fill {
        animation: grow-reading-progress auto linear;
        animation-timeline: scroll();
      }
    }
  }

  /* reduced-motion 設定時はアニメーションを抑制 */
  @media (prefers-reduced-motion: reduce) {
    .reading-progress-fill {
      animation: none !important;
      transform: scaleX(1);
      opacity: 0.3;
    }
  }
</style>
