---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import CRTOverlay from '../components/CRTOverlay.astro';
import AmbientGlow from '../components/AmbientGlow.astro';
import { SITE_NAME, SITE_NAME_UPPER } from '../consts';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
}


const {
  title = SITE_NAME,
  description = 'AstroやHighchartsを使った実験と情報発信をまとめる個人サイト',
  ogType = 'website',
  publishedTime,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Google Analytics 4 Measurement ID
const GA_MEASUREMENT_ID = 'G-3XG4W5WQD1';

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/outfit-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={SITE_NAME} href="/feed.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    {Astro.props.ogImage && <meta property="og:image" content={new URL(Astro.props.ogImage, Astro.site)} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {Astro.props.ogImage && <meta name="twitter:image" content={new URL(Astro.props.ogImage, Astro.site)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />

    <!-- Dark mode & Visual effects (FX) script (run before render to prevent flash) -->
    <script is:inline>
      (function() {
        // Theme
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme || 'dark';
        document.documentElement.setAttribute('data-theme', theme);

        // Visual Effects / FX (a11y: prefers-reduced-motion fallback)
        const storedFx = localStorage.getItem('site-fx') || localStorage.getItem('crt-effects');
        if (storedFx) {
          document.documentElement.setAttribute('data-fx', storedFx);
          document.documentElement.setAttribute('data-crt', storedFx);
        } else {
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const initialFx = prefersReduced ? 'off' : 'on';
          document.documentElement.setAttribute('data-fx', initialFx);
          document.documentElement.setAttribute('data-crt', initialFx);
        }
      })();
    </script>

    <!-- Google Analytics 4 -->
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>

  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へスキップ</a>

    <!-- Deep background glow -->
    <div transition:persist="ambient-glow">
      <AmbientGlow />
    </div>

    <CRTOverlay />



    <header class="header">
      <div class="container header-content">
        <a
          href="/"
          class="logo"
          transition:name="site-logo"
          aria-label={`${SITE_NAME} トップページ`}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          <span class="logo-full">{SITE_NAME_UPPER}</span>
          <span class="logo-short">RK</span>
        </a>
        <nav class="nav-links" aria-label="主要ナビゲーション">
          <a href="/posts" class={`nav-link ${isActive('/posts') ? 'nav-link--accent' : ''}`} aria-current={isActive('/posts') ? 'page' : undefined}>Posts</a>
          <a href="/about" class={`nav-link ${isActive('/about') ? 'nav-link--accent' : ''}`} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a href="/talks" class={`nav-link ${isActive('/talks') ? 'nav-link--accent' : ''}`} aria-current={isActive('/talks') ? 'page' : undefined}>Talks</a>
        </nav>
        <div class="header-actions">
          <button id="fx-toggle" class="fx-toggle" role="switch" aria-checked="true" aria-label="視覚効果・装飾（FX）の切り替え">
            <span class="fx-on-text">FX: ON</span>
            <span class="fx-off-text">FX: OFF</span>
          </button>
          <button id="theme-toggle" class="theme-toggle" aria-label="表示テーマを切り替える">
            <span class="sun-icon">LIGHT</span>
            <span class="moon-icon">DARK</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" class="main" tabindex="-1" transition:animate={fade({ duration: '0.20s' })}>
      <div class="container">
        <slot />
      </div>
    </main>

    <div
      id="slide-loading-overlay"
      class="slide-loading-overlay"
      hidden
      aria-hidden="true"
    >
      <div class="container">
        <div class="slide-loading-meta">
          <span class="skeleton-line skeleton-line--sm" style="width: 5rem;"></span>
          <span class="skeleton-line skeleton-line--sm" style="width: 10rem;"></span>
        </div>
        <div class="slide-loading-frame">
          <div class="slide-loading-pulse"></div>
        </div>
        <div class="slide-loading-controls">
          <span class="skeleton-line" style="width: 4rem; height: 1.5rem;"></span>
          <span class="skeleton-line" style="width: 6rem; height: 0.75rem;"></span>
          <span class="skeleton-line" style="width: 4rem; height: 1.5rem;"></span>
        </div>
      </div>
    </div>

    <script>
      function initTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      }

      function initFx() {
        const stored = localStorage.getItem('site-fx') || localStorage.getItem('crt-effects');
        let fxState = stored;
        if (!fxState) {
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          fxState = prefersReduced ? 'off' : 'on';
        }
        document.documentElement.setAttribute('data-fx', fxState);
        document.documentElement.setAttribute('data-crt', fxState);
        updateFxToggleUI(fxState);
      }

      function updateFxToggleUI(state: string) {
        const toggle = document.getElementById('fx-toggle');
        if (!toggle) return;
        const isChecked = state === 'on';
        toggle.setAttribute('aria-checked', isChecked ? 'true' : 'false');
      }

      function setupFxToggle() {
        const toggle = document.getElementById('fx-toggle');
        if (!toggle) return;

        const current = document.documentElement.getAttribute('data-fx') || 'on';
        updateFxToggleUI(current);

        let powerTimeout: number | undefined;

        toggle.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-fx') || 'on';
          const next = current === 'on' ? 'off' : 'on';

          if (powerTimeout) {
            window.clearTimeout(powerTimeout);
            powerTimeout = undefined;
          }

          if (next === 'on') {
            document.documentElement.setAttribute('data-fx', 'on');
            document.documentElement.setAttribute('data-crt', 'on');
            localStorage.setItem('site-fx', 'on');
            updateFxToggleUI('on');

            document.body.classList.remove('crt-powering-off');
            document.body.classList.add('crt-powering-on');
            powerTimeout = window.setTimeout(() => {
              document.body.classList.remove('crt-powering-on');
            }, 600);
          } else {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (prefersReducedMotion) {
              document.documentElement.setAttribute('data-fx', 'off');
              document.documentElement.setAttribute('data-crt', 'off');
              localStorage.setItem('site-fx', 'off');
              updateFxToggleUI('off');
              document.body.classList.remove('crt-powering-on', 'crt-powering-off');
              return;
            }

            // OFF時は収束ビームを表示してから属性を切り替える
            document.body.classList.remove('crt-powering-on');
            document.body.classList.add('crt-powering-off');
            updateFxToggleUI('off');

            powerTimeout = window.setTimeout(() => {
              document.documentElement.setAttribute('data-fx', 'off');
              document.documentElement.setAttribute('data-crt', 'off');
              localStorage.setItem('site-fx', 'off');
              document.body.classList.remove('crt-powering-off');
            }, 420);
          }
        });
      }

      function setupThemeToggle() {
        const toggle = document.getElementById('theme-toggle');
        toggle?.addEventListener('click', (e) => {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'dark' ? 'light' : 'dark';

          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          // 非対応ブラウザまたは動きを減らす設定では即時に切り替える
          // @ts-ignore
          if (!document.startViewTransition || prefersReducedMotion) {
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            return;
          }

          // @ts-ignore
          document.documentElement.setAttribute('data-theme-transition', 'true');

          // @ts-ignore
          const transition = document.startViewTransition(() => {
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });

          // クリック位置を起点に円形展開アニメーション
          const x = (e as MouseEvent).clientX;
          const y = (e as MouseEvent).clientY;
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          transition.ready.then(() => {
            document.documentElement.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${endRadius}px at ${x}px ${y}px)`,
                ],
              },
              {
                duration: 500,
                easing: 'ease-in-out',
                pseudoElement: '::view-transition-new(root)',
              }
            );
          });

          transition.finished.finally(() => {
            document.documentElement.removeAttribute('data-theme-transition');
          });
        });
      }

      // 初期化とイベントリスナー設定
      // astro:page-load は初回ロード時とページ遷移後に発火する
      document.addEventListener('astro:page-load', () => {
        setupThemeToggle();
        setupFxToggle();
      });

      // astro:after-swap は新しいHTMLに入れ替わった直後（表示前）に発火
      // ここでテーマとFX属性を再適用しないと、一瞬デフォルトに戻るチラつきが起きる
      document.addEventListener('astro:after-swap', () => {
        initTheme();
        initFx();
      });

      // /slides/[slug] への遷移開始時にスケルトンを被せる（現在ページの overlay に対して）
      document.addEventListener('astro:before-preparation', (event) => {
        // @ts-ignore — Astro Transition event
        const to: URL | undefined = event.to;
        if (to && /^\/slides\/[^/]+/.test(to.pathname)) {
          const overlay = document.getElementById('slide-loading-overlay');
          if (overlay) overlay.hidden = false;
        }
      });
    </script>

    <!-- Vercel Speed Insights -->
    <script is:inline>
      window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script async defer src="/_vercel/speed-insights/script.js"></script>

    <!-- Vercel Analytics -->
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script async defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
