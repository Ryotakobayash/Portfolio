---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import StickyToc from '../../components/StickyToc';
import ArticlePerformance from '../../components/ArticlePerformance';
import ShareButtons from '../../components/ShareButtons';
import RelatedPosts from '../../components/RelatedPosts.astro';
import CustomImage from '../../components/CustomImage.astro';
import QuadtreeThumbnail from '../../components/QuadtreeThumbnail';
import LocalArticleNetworkGraph from '../../components/LocalArticleNetworkGraph';
import { SITE_NAME } from '../../consts';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: (post.data.slug || post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const slug = (post.data.slug || post.id);
const { Content, headings } = await render(post);

const body = post.body || '';
const charCount = body.length;
const readingTime = Math.max(1, Math.ceil(charCount / 500));

const articleDescription = post.data.excerpt
  || body.replace(/[#*\-\[\]()>|`~\n]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 120) + '…';

const articleJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date,
  description: articleDescription,
  url: new URL(`/posts/${slug}`, Astro.site).href,
  author: { '@type': 'Person', name: 'Ryota Kobayashi' },
};
if (post.data.updatedDate) {
  articleJsonLd.dateModified = post.data.updatedDate;
}

// TOC用にheadingsをフォーマット
// rehype-autolink-headings が見出し末尾に '#' を append するため、TOC 表示用には除去する
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({
    id: h.slug,
    text: h.text.replace(/#\s*$/, ''),
    level: h.depth,
  }));

// 関連記事用に全記事メタデータを取得
const allPosts = await getPublishedPosts();
const allPostsMeta = allPosts.map((p) => ({
  slug: (p.data.slug || p.id),
  title: p.data.title,
  tags: p.data.tags || [],
  date: p.data.date,
}));
---

<BaseLayout
  title={`${post.data.title} | ${SITE_NAME}`}
  description={articleDescription}
  ogImage={`/og/${slug}.png`}
  ogType="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updatedDate}
  jsonLd={articleJsonLd}
>
  <div class="article-layout">
    <!-- メインコンテンツ -->
    <article class="article">
      <header class="article-header">
        <a href="/posts" class="back-link">← Posts</a>
        {post.data.thumbnail && (
          <div class="article-thumbnail-wrapper">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              class="article-thumbnail-img"
              fetchpriority="high"
              decoding="async"
            />
            <QuadtreeThumbnail
              client:load
              src={post.data.thumbnail}
              alt={post.data.title}
              animateOnLoad={true}
              ssrImageOverlay={true}
            />
          </div>
        )}
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="article-tags">
            {post.data.tags.map((tag: string) => (
              <a href={`/tags/${tag.replace(/\//g, '-')}`} class="badge">{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="article-performance-wrapper">
        <ArticlePerformance
          client:idle
          slug={slug}
          wordCount={charCount}
          readingTime={readingTime}
          publishDate={post.data.date}
          updatedDate={post.data.updatedDate}
        />
      </div>

      <!-- モバイル用TOC -->
      {toc.length > 0 && (
        <nav class="mobile-toc">
          <h2 class="mobile-toc-title">目次</h2>
          <ul class="mobile-toc-list">
            {toc.map((item) => (
              <li style={`padding-left: ${(item.level - 2) * 1}rem`}>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content components={{ img: CustomImage }} />
      </div>

      <!-- 記事フッター -->
      <footer class="article-footer">
        <ShareButtons
          client:idle
          title={post.data.title}
          url={new URL(`/posts/${slug}`, Astro.site).href}
        />
        <!-- モバイル用インタラクティブグラフ -->
        <div class="mobile-graph-container">
          <h2 class="mobile-section-title">インタラクティブグラフ</h2>
          <LocalArticleNetworkGraph
            client:media="(max-width: 1023px)"
            currentSlug={slug}
            currentTitle={post.data.title}
            currentTags={post.data.tags || []}
            allPosts={allPostsMeta}
          />
        </div>
        <RelatedPosts
          currentSlug={slug}
          currentTags={post.data.tags || []}
          allPosts={allPostsMeta}
        />
      </footer>

    </article>

    <!-- 画像クリックで拡大表示(Reactを使わない素のスクリプト。
         client:only island を置くと dev の View Transitions が遷移先を
         隠し iframe でフルロードして遅くなるため island 化しない) -->
    <script>
      function enableImageZoom() {
        const images = document.querySelectorAll<HTMLImageElement>('.prose img');

        images.forEach((img) => {
          if (img.dataset.zoomEnabled) return;
          img.dataset.zoomEnabled = 'true';

          img.style.cursor = 'zoom-in';
          img.style.transition = 'transform 150ms ease';
          if (!img.getAttribute('tabindex')) img.setAttribute('tabindex', '0');
          img.setAttribute('role', 'button');
          img.setAttribute('aria-haspopup', 'dialog');

          const openZoom = () => {
            const overlay = document.createElement('div');
            overlay.setAttribute('role', 'dialog');
            overlay.setAttribute('aria-modal', 'true');
            overlay.setAttribute('aria-label', img.alt || '画像の拡大表示');
            overlay.style.cssText = `
              position: fixed;
              inset: 0;
              background-color: rgba(0, 0, 0, 0.9);
              display: flex;
              align-items: center;
              justify-content: center;
              z-index: 1000;
              cursor: zoom-out;
              padding: 20px;
            `;

            const closeBtn = document.createElement('button');
            closeBtn.setAttribute('aria-label', '閉じる');
            closeBtn.textContent = '✕';
            closeBtn.style.cssText = `
              position: absolute; top: 16px; right: 16px;
              background: none; border: 1px solid rgba(255,255,255,0.3);
              color: #fff; font-size: 1.25rem; padding: 4px 10px;
              cursor: pointer; z-index: 1001; line-height: 1;
            `;

            const zoomedImg = document.createElement('img');
            zoomedImg.src = img.src;
            zoomedImg.alt = img.alt;
            zoomedImg.style.cssText = `
              max-width: 90vw;
              max-height: 90vh;
              object-fit: contain;
              border-radius: 8px;
              animation: zoomIn 200ms ease;
            `;

            if (!document.getElementById('zoom-styles')) {
              const style = document.createElement('style');
              style.id = 'zoom-styles';
              style.textContent = `
                @keyframes zoomIn {
                  from { transform: scale(0.9); opacity: 0; }
                  to { transform: scale(1); opacity: 1; }
                }
              `;
              document.head.appendChild(style);
            }

            overlay.appendChild(zoomedImg);
            overlay.appendChild(closeBtn);
            document.body.appendChild(overlay);
            document.body.style.overflow = 'hidden';

            closeBtn.focus();

            const close = () => {
              overlay.remove();
              document.body.style.overflow = '';
              document.removeEventListener('keydown', handleKeyDown);
              img.focus();
            };
            overlay.addEventListener('click', (e) => {
              if (e.target === overlay) close();
            });
            closeBtn.addEventListener('click', close);
            const handleKeyDown = (e: KeyboardEvent) => {
              if (e.key === 'Escape') close();
              if (e.key === 'Tab') {
                e.preventDefault();
                closeBtn.focus();
              }
            };
            document.addEventListener('keydown', handleKeyDown);
          };

          img.addEventListener('click', openZoom);
          img.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openZoom();
            }
          });
        });
      }

      document.addEventListener('astro:page-load', enableImageZoom);
    </script>

    <!-- サイドバー（デスクトップ） -->
    <aside class="sidebar">
      <div class="sidebar-graph-wrapper">
        <h2 class="sidebar-section-title">インタラクティブグラフ</h2>
        <LocalArticleNetworkGraph
          client:media="(min-width: 1024px)"
          currentSlug={slug}
          currentTitle={post.data.title}
          currentTags={post.data.tags || []}
          allPosts={allPostsMeta}
        />
      </div>
      {toc.length > 0 && (
        <div class="sidebar-toc-wrapper">
          <h2 class="sidebar-section-title">このページの内容</h2>
          <StickyToc client:idle toc={toc} />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<script>
  function setupImageFigures() {
    const images = document.querySelectorAll('.prose img:not(.blog-figure-img)');
    
    images.forEach((img, index) => {
      // Avoid processing the same image twice
      if (img.parentElement?.tagName.toLowerCase() === 'figure') return;

      const altText = img.getAttribute('alt');
      const titleText = img.getAttribute('title');
      
      // title属性があればキャプションとして使い、なければalt属性をフォールバックとして使う
      const captionText = titleText || altText;
      const showCaption = captionText && captionText.trim().length > 0;

      const figure = document.createElement('figure');
      figure.className = 'blog-figure';

      // Insert figure before img, then move img into figure
      img.parentNode?.insertBefore(figure, img);
      
      // Add a specific class to prevent reprocessing or conflict with other img styles
      img.classList.add('blog-figure-img');
      figure.appendChild(img);

      if (showCaption) {
        const figcaption = document.createElement('figcaption');
        figcaption.innerHTML = `<span class="figure-number">図${index + 1}: </span>${captionText}`;
        figure.appendChild(figcaption);
      }
    });
  }

  // Run on initial load and setup a listener for Astro View Transitions if used
  document.addEventListener('DOMContentLoaded', () => {
    setupImageFigures();
    setupFootnotes();
    setupHeadingAnchorCopy();
  });
  document.addEventListener('astro:page-load', () => {
    setupImageFigures();
    setupFootnotes();
    setupHeadingAnchorCopy();
  });

  /**
   * 見出し横の '#' クリックでセクション URL をクリップボードにコピー、
   * 直後に 'Copied!' ツールチップに切り替える。
   * 委譲リスナを document に 1 回だけ登録する。
   */
  function setupHeadingAnchorCopy() {
    if ((window as any).__headingAnchorCopyBound) return;
    (window as any).__headingAnchorCopyBound = true;

    document.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement | null;
      const anchor = target?.closest('.heading-anchor') as HTMLAnchorElement | null;
      if (!anchor) return;

      const href = anchor.getAttribute('href');
      if (!href) return;

      const url = `${window.location.origin}${window.location.pathname}${href}`;
      try {
        await navigator.clipboard.writeText(url);
        anchor.classList.add('is-copied');
        window.setTimeout(() => anchor.classList.remove('is-copied'), 1500);
      } catch (err) {
        console.warn('Failed to copy section URL', err);
      }
    });
  }

  /**
   * 脚注の UI/UX を向上させる
   * - 本文中の [^1] 参照をクリック/ホバーでその場にポップオーバーカードを展開
   * - 右サイドバー（目次・TOC）との衝突を 100% 解消
   * - 冪等性を担保し多重初期化を防止
   * - 記事末尾の脚注一覧へのスムーズジャンプとハイライト
   */
  function setupFootnotes() {
    const footnoteSection = document.querySelector('.footnotes');
    if (!footnoteSection) return;

    const refs = document.querySelectorAll<HTMLAnchorElement>('sup a[data-footnote-ref]');
    if (refs.length === 0) return;

    refs.forEach((ref) => {
      const sup = ref.closest('sup');
      if (!sup) return;

      // 二重初期化防止ガード
      if (sup.dataset.footnoteInitialized === 'true') return;
      sup.dataset.footnoteInitialized = 'true';

      const href = ref.getAttribute('href');
      if (!href) return;
      // href は "#user-content-fn-1" など
      const id = href.replace(/^#/, '');
      const footnoteItem = footnoteSection.querySelector(`#${CSS.escape(id)}`);
      if (!footnoteItem) return;

      // 既存の旧 sidenote 要素があれば削除
      sup.parentElement?.querySelectorAll('.sidenote').forEach((el) => el.remove());

      // 注釈番号
      const noteNumber = ref.textContent?.trim() || '';

      // 注釈本文（バックリンク ↩ を除外）
      const clone = footnoteItem.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('a[data-footnote-backref]').forEach((el) => el.remove());
      const noteHtml = clone.innerHTML.trim();

      // ポップオーバー要素を生成
      const popover = document.createElement('div');
      popover.className = 'footnote-popover';
      popover.setAttribute('role', 'tooltip');
      popover.id = `footnote-popover-${id}`;
      popover.innerHTML = `
        <div class="footnote-popover-header">
          <span class="footnote-popover-badge">NOTE [${noteNumber}]</span>
          <div class="footnote-popover-actions">
            <a href="${href}" class="footnote-popover-jump" title="記事末尾の脚注へジャンプ" aria-label="記事末尾の脚注へジャンプ">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13l5 5 5-5M12 4v14"/></svg>
            </a>
            <button type="button" class="footnote-popover-close" title="閉じる" aria-label="閉じる">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
        <div class="footnote-popover-body">${noteHtml}</div>
      `;

      sup.style.position = 'relative';
      sup.appendChild(popover);

      // アクセシビリティ属性
      ref.setAttribute('aria-expanded', 'false');
      ref.setAttribute('aria-controls', popover.id);

      let closeTimeout: number | undefined;

      const adjustPosition = () => {
        popover.classList.remove('align-right', 'align-left');
        const rect = popover.getBoundingClientRect();
        const padding = 16;
        if (rect.right > window.innerWidth - padding) {
          popover.classList.add('align-right');
        } else if (rect.left < padding) {
          popover.classList.add('align-left');
        }
      };

      const openPopover = (isPinned = false) => {
        if (closeTimeout) {
          window.clearTimeout(closeTimeout);
          closeTimeout = undefined;
        }

        // 他のポップオーバーを閉じる
        if (isPinned) {
          document.querySelectorAll('.footnote-popover.is-open').forEach((p) => {
            if (p !== popover) {
              p.classList.remove('is-open', 'is-pinned');
              const otherRef = p.parentElement?.querySelector('a[data-footnote-ref]');
              otherRef?.setAttribute('aria-expanded', 'false');
            }
          });
        }

        popover.classList.add('is-open');
        if (isPinned) {
          popover.classList.add('is-pinned');
        }
        ref.setAttribute('aria-expanded', 'true');
        adjustPosition();
      };

      const closePopover = (force = false) => {
        if (!force && popover.classList.contains('is-pinned')) {
          return;
        }
        popover.classList.remove('is-open', 'is-pinned');
        ref.setAttribute('aria-expanded', 'false');
      };

      // ホバー時の動作（マウスが乗っている間は表示、離れたらディレイで非表示）
      ref.addEventListener('mouseenter', () => openPopover(false));
      ref.addEventListener('mouseleave', () => {
        closeTimeout = window.setTimeout(() => closePopover(false), 200);
      });

      popover.addEventListener('mouseenter', () => {
        if (closeTimeout) {
          window.clearTimeout(closeTimeout);
          closeTimeout = undefined;
        }
      });
      popover.addEventListener('mouseleave', () => {
        closeTimeout = window.setTimeout(() => closePopover(false), 200);
      });

      // クリック時の動作（ピン留めトグル）
      ref.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (popover.classList.contains('is-open') && popover.classList.contains('is-pinned')) {
          closePopover(true);
        } else {
          openPopover(true);
        }
      });

      // 閉じるボタン
      const closeBtn = popover.querySelector('.footnote-popover-close');
      closeBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closePopover(true);
      });

      // 末尾へのジャンプリンク
      const jumpLink = popover.querySelector('.footnote-popover-jump');
      jumpLink?.addEventListener('click', () => {
        closePopover(true);
      });
    });

    // 記事末尾の脚注から本文へ戻る（↩）リンク押下時に、残っているポップオーバーを全て閉じる
    footnoteSection.querySelectorAll('a[data-footnote-backref]').forEach((backref) => {
      backref.addEventListener('click', () => {
        document.querySelectorAll('.footnote-popover.is-open').forEach((popover) => {
          popover.classList.remove('is-open', 'is-pinned');
          const ref = popover.parentElement?.querySelector('a[data-footnote-ref]');
          ref?.setAttribute('aria-expanded', 'false');
        });
      });
    });

    // グローバル閉じるハンドラー（外側クリック & Escキー）
    if (!(window as any).__footnoteGlobalDismissBound) {
      (window as any).__footnoteGlobalDismissBound = true;

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target?.closest('sup') && !target?.closest('.footnote-popover')) {
          document.querySelectorAll('.footnote-popover.is-open').forEach((popover) => {
            popover.classList.remove('is-open', 'is-pinned');
            const ref = popover.parentElement?.querySelector('a[data-footnote-ref]');
            ref?.setAttribute('aria-expanded', 'false');
          });
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          document.querySelectorAll('.footnote-popover.is-open').forEach((popover) => {
            popover.classList.remove('is-open', 'is-pinned');
            const ref = popover.parentElement?.querySelector('a[data-footnote-ref]');
            ref?.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  }
</script>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr 280px;
    }
  }

  .article {
    min-width: 0;
  }

  .sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .sidebar {
      display: block;
    }
  }

  /* サイドバーのセクションタイトル */
  .sidebar-section-title {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid var(--color-border);
    font-feature-settings: "palt";
  }

  .sidebar-graph-wrapper {
    margin-bottom: var(--spacing-xl);
    /* LocalArticleNetworkGraph がハイドレーションされるまでの間、
       タイトル + グラフ本体の高さをあらかじめ確保して CLS を防ぐ */
    min-height: 348px;
  }

  /* モバイル・レスポンシブグラフ制御 */
  .mobile-graph-container {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    display: block;
    /* デスクトップ同様、グラフのハイドレーション待ちによる CLS を防ぐ */
    min-height: 348px;
  }

  .mobile-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
    font-feature-settings: "palt";
  }

  @media (min-width: 1024px) {
    .mobile-graph-container {
      display: none; /* デスクトップ表示時はフッター内のグラフを隠す */
    }
  }

  .article-header {
    margin-bottom: var(--spacing-xl);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-lg);
  }

  .article-thumbnail-wrapper {
    position: relative;
    margin-bottom: var(--spacing-lg);
    max-width: 100%;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .article-thumbnail-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-performance-wrapper {
    margin-bottom: var(--spacing-xl);
  }

  .article-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    font-feature-settings: "palt";
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .meta-separator {
    color: var(--color-text-muted);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  /* モバイルTOC */
  .mobile-toc {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-primary);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  @media (min-width: 1024px) {
    .mobile-toc {
      display: none;
    }
  }

  .mobile-toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
  }

  .mobile-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-toc-list li {
    margin-bottom: var(--spacing-xs);
  }

  .mobile-toc-list a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .mobile-toc-list a:hover {
