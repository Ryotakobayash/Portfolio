---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import StickyToc from '../../components/StickyToc';
import ArticlePerformance from '../../components/ArticlePerformance';
import ShareButtons from '../../components/ShareButtons';
import RelatedPosts from '../../components/RelatedPosts.astro';
import CustomImage from '../../components/CustomImage.astro';
import QuadtreeThumbnail from '../../components/QuadtreeThumbnail';
import LocalArticleNetworkGraph from '../../components/LocalArticleNetworkGraph';
import { SITE_NAME } from '../../consts';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: (post.data.slug || post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const slug = (post.data.slug || post.id);
const { Content, headings } = await render(post);

const body = post.body || '';
const charCount = body.length;
const readingTime = Math.max(1, Math.ceil(charCount / 500));

const articleDescription = post.data.excerpt
  || body.replace(/[#*\-\[\]()>|`~\n]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 120) + '…';

const articleJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date,
  description: articleDescription,
  url: new URL(`/posts/${slug}`, Astro.site).href,
  author: { '@type': 'Person', name: 'Ryota Kobayashi' },
};
if (post.data.updatedDate) {
  articleJsonLd.dateModified = post.data.updatedDate;
}

// TOC用にheadingsをフォーマット
// rehype-autolink-headings が見出し末尾に '#' を append するため、TOC 表示用には除去する
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({
    id: h.slug,
    text: h.text.replace(/#\s*$/, ''),
    level: h.depth,
  }));

// 関連記事用に全記事メタデータを取得
const allPosts = await getPublishedPosts();
const allPostsMeta = allPosts.map((p) => ({
  slug: (p.data.slug || p.id),
  title: p.data.title,
  tags: p.data.tags || [],
  date: p.data.date,
}));
---

<BaseLayout
  title={`${post.data.title} | ${SITE_NAME}`}
  description={articleDescription}
  ogImage={`/og/${slug}.png`}
  ogType="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updatedDate}
  jsonLd={articleJsonLd}
>
  <div class="article-layout">
    <!-- メインコンテンツ -->
    <article class="article">
      <header class="article-header">
        <a href="/posts" class="back-link">← Posts</a>
        {post.data.thumbnail && (
          <div class="article-thumbnail-wrapper">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              class="article-thumbnail-img"
              fetchpriority="high"
              decoding="async"
            />
            <QuadtreeThumbnail
              client:load
              src={post.data.thumbnail}
              alt={post.data.title}
              animateOnLoad={true}
              ssrImageOverlay={true}
            />
          </div>
        )}
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="article-tags">
            {post.data.tags.map((tag: string) => (
              <a href={`/tags/${tag.replace(/\//g, '-')}`} class="badge">{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="article-performance-wrapper">
        <ArticlePerformance
          client:idle
          slug={slug}
          wordCount={charCount}
          readingTime={readingTime}
          publishDate={post.data.date}
          updatedDate={post.data.updatedDate}
        />
      </div>

      <!-- モバイル用TOC -->
      {toc.length > 0 && (
        <nav class="mobile-toc">
          <h2 class="mobile-toc-title">目次</h2>
          <ul class="mobile-toc-list">
            {toc.map((item) => (
              <li style={`padding-left: ${(item.level - 2) * 1}rem`}>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content components={{ img: CustomImage }} />
      </div>

      <!-- 記事フッター -->
      <footer class="article-footer">
        <ShareButtons
          client:idle
          title={post.data.title}
          url={new URL(`/posts/${slug}`, Astro.site).href}
        />
        <!-- モバイル用インタラクティブグラフ -->
        <div class="mobile-graph-container">
          <h2 class="mobile-section-title">インタラクティブグラフ</h2>
          <LocalArticleNetworkGraph
            client:media="(max-width: 1023px)"
            currentSlug={slug}
            currentTitle={post.data.title}
            currentTags={post.data.tags || []}
            allPosts={allPostsMeta}
          />
        </div>
        <RelatedPosts
          currentSlug={slug}
          currentTags={post.data.tags || []}
          allPosts={allPostsMeta}
        />
      </footer>

    </article>

    <!-- 画像クリックで拡大表示（実装は src/scripts/article/imageZoom.ts） -->
    <script>
      import { enableImageZoom } from '../../scripts/article/imageZoom';

      document.addEventListener('astro:page-load', enableImageZoom);
    </script>

    <!-- サイドバー（デスクトップ） -->
    <aside class="sidebar">
      <div class="sidebar-graph-wrapper">
        <h2 class="sidebar-section-title">インタラクティブグラフ</h2>
        <LocalArticleNetworkGraph
          client:media="(min-width: 1024px)"
          currentSlug={slug}
          currentTitle={post.data.title}
          currentTags={post.data.tags || []}
          allPosts={allPostsMeta}
        />
      </div>
      {toc.length > 0 && (
        <div class="sidebar-toc-wrapper">
          <h2 class="sidebar-section-title">このページの内容</h2>
          <StickyToc client:idle toc={toc} />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<script>
  import { setupImageFigures } from '../../scripts/article/imageFigures';
  import { setupFootnotes } from '../../scripts/article/footnotes';
  import { setupHeadingAnchorCopy } from '../../scripts/article/headingAnchorCopy';

  function initArticle() {
    setupImageFigures();
    setupFootnotes();
    setupHeadingAnchorCopy();
  }

  // 初回表示と View Transitions による遷移後の両方で初期化する（各関数は冪等）
  document.addEventListener('DOMContentLoaded', initArticle);
  document.addEventListener('astro:page-load', initArticle);
</script>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr 280px;
    }
  }

  .article {
    min-width: 0;
  }

  .sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .sidebar {
      display: block;
    }
  }

  /* サイドバーのセクションタイトル */
  .sidebar-section-title {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid var(--color-border);
    font-feature-settings: "palt";
  }

  .sidebar-graph-wrapper {
    margin-bottom: var(--spacing-xl);
    /* LocalArticleNetworkGraph がハイドレーションされるまでの間、
       タイトル + グラフ本体の高さをあらかじめ確保して CLS を防ぐ */
    min-height: 348px;
  }

  /* モバイル・レスポンシブグラフ制御 */
  .mobile-graph-container {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    display: block;
    /* デスクトップ同様、グラフのハイドレーション待ちによる CLS を防ぐ */
    min-height: 348px;
  }

  .mobile-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
    font-feature-settings: "palt";
  }

  @media (min-width: 1024px) {
    .mobile-graph-container {
      display: none; /* デスクトップ表示時はフッター内のグラフを隠す */
    }
  }

  .article-header {
    margin-bottom: var(--spacing-xl);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-lg);
  }

  .article-thumbnail-wrapper {
    position: relative;
    margin-bottom: var(--spacing-lg);
    max-width: 100%;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .article-thumbnail-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-performance-wrapper {
    margin-bottom: var(--spacing-xl);
  }

  .article-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    font-feature-settings: "palt";
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .meta-separator {
    color: var(--color-text-muted);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  /* モバイルTOC */
  .mobile-toc {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-primary);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  @media (min-width: 1024px) {
    .mobile-toc {
      display: none;
    }
  }

  .mobile-toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
  }

  .mobile-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-toc-list li {
    margin-bottom: var(--spacing-xs);
  }

  .mobile-toc-list a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .mobile-toc-list a:hover {
    color: var(--color-primary);
  }

  /* Prose styles for Markdown content */
  .prose {
    line-height: 1.8;
    max-width: 40em;
    width: 100%;
  }

  /* 本文内の主要なブロック要素の最大幅を 40em（親.prose）に統一して揃える */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6),
  .prose :global(pre),
  .prose :global(.expressive-code),
  .prose :global(table),
  .prose :global(blockquote),
  .prose :global(figure:not(.sidenote)),
  .prose :global(hr) {
    max-width: 100%;
    width: 100%;
  }

  /* Expressive Code のネガティブマージンをキャンセルし、親の幅にピタッと揃える */
  .prose :global(.expressive-code) {
    margin-inline: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }
  .prose :global(.expressive-code .frame) {
    max-width: 100% !important;
  }

  .prose :global(h2) {
    font-size: var(--p-step-2);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-block-start: var(--s-space-gap-md);
    margin-block-end: var(--s-space-gutter-xs);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    scroll-margin-top: calc(var(--header-height) + var(--spacing-lg));
  }

  .prose :global(h3) {
    font-size: var(--p-step-1);
    font-weight: 600;
    margin-block-start: var(--s-space-gap-sm);
    margin-block-end: var(--s-space-gutter-xs);
    scroll-margin-top: calc(var(--header-height) + var(--spacing-lg));
  }

  .prose :global(.heading-anchor) {
    position: relative;
    margin-left: 0.4em;
    color: var(--color-text-muted);
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 150ms ease, color 80ms ease;
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(.heading-anchor:focus),
  .prose :global(.heading-anchor.is-copied) {
    opacity: 1;
  }

  .prose :global(.heading-anchor:hover),
  .prose :global(.heading-anchor:focus) {
    color: var(--color-primary);
  }

  /* 自前ツールチップ (native title はラグがあるため使わない) */
  .prose :global(.heading-anchor::after) {
    content: 'このセクションへのリンク';
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background-color: var(--color-bg-card);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 80ms ease;
  }

  .prose :global(.heading-anchor:hover::after),
  .prose :global(.heading-anchor:focus::after),
  .prose :global(.heading-anchor.is-copied::after) {
    opacity: 1;
  }

  .prose :global(.heading-anchor.is-copied::after) {
    content: 'Copied!';
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .prose :global(p) {
    margin-block: 0.75lh;
  }

  .prose :global(:is(dd, small)) {
    max-width: 40em;
    width: 100%;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .prose :global(:not(pre) > code) {
    background-color: var(--color-bg-secondary);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
  }

  .prose :global(.expressive-code) {
    margin-block: 1rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--spacing-md);
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: normal;
    letter-spacing: 0.02em;
  }

  /* Dynamically created figures via JS */
  .prose :global(.blog-figure) {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2.5rem 0;
    width: 100%;
  }

  /* Max-height fix for tall vertical images */
  .prose :global(.blog-figure-img) {
    max-width: 100%;
    max-height: 60vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background-color: var(--color-surface, #f5f5f5);
  }

  .prose :global(.blog-figure figcaption) {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted, #666);
    text-align: center;
    line-height: 1.5;
  }

  .prose :global(.figure-number) {
    font-weight: 600;
  }

  .prose :global(img:not(.blog-figure-img)) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--spacing-sm) var(--spacing-md);
    text-align: left;
  }

  .prose :global(th) {
    background-color: var(--color-bg-secondary);
    font-weight: 600;
  }

  /* ===== 脚注 / Footnotes ===== */

  /* 本文中の上付き脚注参照 */
  .prose :global(sup) {
    position: relative;
    display: inline-flex;
    vertical-align: baseline;
    top: -0.45em;
    font-size: 0.75em;
    line-height: 0;
    scroll-margin-top: clamp(140px, 35vh, 280px);
  }

  .prose :global(sup a[data-footnote-ref]),
  .prose :global([id^="user-content-fnref-"]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    margin: 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.25);
    border-radius: 4px;
    box-sizing: border-box;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    scroll-margin-top: clamp(140px, 35vh, 280px);
  }

  .prose :global(sup a[data-footnote-ref]:hover),
  .prose :global(sup a[data-footnote-ref][aria-expanded="true"]) {
    color: #fff;
    background: rgba(0, 240, 255, 0.25);
    border-color: var(--color-primary);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.4);
  }

  /* 脚注からの戻りジャンプ時のターゲットハイライト (約3秒で通常スタイルへ自然復帰) */
  .prose :global(sup:target a[data-footnote-ref]),
  .prose :global(sup:has(:target) a[data-footnote-ref]),
  .prose :global(sup a[data-footnote-ref]:target),
  .prose :global([id^="user-content-fnref-"]:target) {
    animation: footnote-target-pulse 3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes footnote-target-pulse {
    0% {
      transform: scale(1.35);
      color: #fff;
      background: var(--color-primary);
      border-color: var(--color-primary);
      box-shadow: 0 0 24px rgba(0, 240, 255, 0.95), 0 0 8px #fff;
    }
    30% {
      transform: scale(1);
      color: #fff;
      background: var(--color-primary);
      border-color: var(--color-primary);
      box-shadow: 0 0 16px rgba(0, 240, 255, 0.8), 0 0 4px #fff;
    }
    70% {
      transform: scale(1);
      color: #fff;
      background: rgba(0, 240, 255, 0.4);
      border-color: var(--color-primary);
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
    }
    100% {
      transform: scale(1);
      color: var(--color-primary);
      background: rgba(0, 240, 255, 0.08);
      border-color: rgba(0, 240, 255, 0.25);
      box-shadow: none;
    }
  }

  /* 脚注ポップオーバーカード */
  .prose :global(.footnote-popover) {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: max-content;
    min-width: 240px;
    max-width: min(340px, 85vw);
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-primary);
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 14px rgba(0, 240, 255, 0.15);
    backdrop-filter: blur(12px);
    z-index: 100;
    line-height: 1.55;
    font-size: 0.78rem;
    color: var(--color-text);
    font-weight: 400;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
  }

  /* 矢印（上向き三角） */
  .prose :global(.footnote-popover::before) {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent var(--color-primary) transparent;
  }

  /* 左右位置アライメント調整（画面端のはみ出し防止） */
  .prose :global(.footnote-popover.align-right) {
    left: auto;
    right: -12px;
    transform: translateY(4px);
  }
  .prose :global(.footnote-popover.align-right::before) {
    left: auto;
    right: 20px;
    transform: none;
  }

  .prose :global(.footnote-popover.align-left) {
    left: -12px;
    right: auto;
    transform: translateY(4px);
  }
  .prose :global(.footnote-popover.align-left::before) {
    left: 20px;
    transform: none;
  }

  /* ポップオーバー表示状態 */
  .prose :global(.footnote-popover.is-open) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .prose :global(.footnote-popover.align-right.is-open) {
    transform: translateY(0);
  }
  .prose :global(.footnote-popover.align-left.is-open) {
    transform: translateY(0);
  }

  .prose :global(.footnote-popover-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.4rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px dashed var(--color-border);
  }

  .prose :global(.footnote-popover-badge) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-primary);
