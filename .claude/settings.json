{
  "permissions": {
    "allow": [
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(npx fontpie:*)",
      "Bash(gzip -c:*)",
      "Bash(sips:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git restore:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/textlint-content.mjs\"",
            "timeout": 30,
            "statusMessage": "textlint で校正中..."
          }
        ]
      }
    ]
  }
}
